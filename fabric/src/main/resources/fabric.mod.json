{
	"schemaVersion": 1,
	"id": "${mod_id}",
	"version": "${mod_version}",
	"name": "${mod_name}",
	"description": "Server and client Fortnite building and combat mechanics prototype.",
	"authors": [
		"brainage04"
	],
	"contact": {
		"homepage": "https://github.com/brainage04/FortniteInMinecraft",
		"sources": "https://github.com/brainage04/FortniteInMinecraft"
	},
	"license": "MIT",
	"icon": "assets/fortniteinminecraft/icon.png",
	"environment": "*",
	"entrypoints": {
		"client": [
			"io.github.brainage04.fortniteinminecraft.fabric.FortniteInMinecraftFabricClient"
		],
		"main": [
			"io.github.brainage04.fortniteinminecraft.fabric.FortniteInMinecraftFabric"
		]
	},
	"mixins": [
		"fortniteinminecraft.mixins.json",
		"fortniteinminecraft.client.mixins.json"
	],
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": "~${minecraft_version}",
		"java": ">=${java_version}",
		"fabric-api": "*"
	},
	"suggests": {
		"hudrendererlib": ">=${hudrendererlib_version}"
	},
	"accessWidener": "fortniteinminecraft.accesswidener"
}
