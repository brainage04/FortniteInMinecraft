{
  "schemaVersion": 1,
  "id": "fortnite_in_minecraft",
  "version": "${version}",
  "name": "Fortnite In Minecraft",
  "description": "A mod that ports Fortnite's building mechanics (and some guns + other items) to Minecraft.",
  "authors": [
    "brainage04"
  ],
  "contact": {
    "homepage": "https://github.com/brainage04/FortniteInMinecraft",
    "sources": "https://github.com/brainage04/FortniteInMinecraft"
  },
  "license": "MIT",
  "icon": "assets/fortnite_in_minecraft/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.github.brainage04.fortnite_in_minecraft.FortniteInMinecraft"
    ]
  },
  "mixins": [
    "fortnite_in_minecraft.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.17.2",
    "minecraft": "~1.21.8",
    "java": ">=21",
    "fabric-api": "*"
  }
}